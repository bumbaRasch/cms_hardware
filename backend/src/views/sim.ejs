<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sim List</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-table@1.24.0/dist/bootstrap-table.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@2.1.1/css/boxicons.min.css">
    <link rel="stylesheet" href="/public/css/styles.css">
</head>
<body id="body-pd">
    <div id="alert-container"></div>
    <%- include('header') %>
    <%- include('sidebar', { currentPath: currentPath }) %>
    <div class="container">
        <h4>Sim Cards</h4>
        <table 
            data-show-export="true"
            id="table"
            data-toggle="table"
            data-toolbar="#toolbar"
            data-search="true"
            data-show-toggle="true"
            data-show-fullscreen="true"
            data-show-columns="true"
            data-show-columns-toggle-all="true"
            data-pagination="true"
            data-show-pagination-switch="true"
            data-page-list="[10, 25, 50, all]"
            data-sortable="true"
            data-id-field="SIM_ID"
            data-locale="en-US"
            class="table table-bordered table-hover">
        <thead class="table-primary">
            <tr>
                <th data-field="SIM_ID" data-sortable="true">ID</th>
                <th data-field="SIM_NUMBER" data-sortable="true">Number</th>
                <th data-field="PROVIDER_NAME" data-sortable="true">Provider</th>
                <th data-field="TARIFF_NAME" data-sortable="true">Tariff</th>
                <th data-field="LOC_NAME" data-sortable="true">Location</th>
                <th data-field="ST_NAME" data-sortable="true">Status</th>
                <th data-field="PIN1" data-sortable="true">PIN1</th>
                <th data-field="PUK1" data-sortable="true">PUK1</th>
                <th data-field="PIN2" data-sortable="true">PIN2</th>
                <th data-field="PUK2" data-sortable="true">PUK2</th>
                <th data-field="ACTIVATION_DATE" data-sortable="true">Activation Date</th>
                <th data-field="EXPIRATION_DATE" data-sortable="true">Expiration Date</th>
                <th data-field="COMMENTS" data-sortable="true">Comments</th>
                <th data-field="SIM_CREATED_AT" data-sortable="true">Created At</th>
                <th data-field="SIM_UPDATED_AT" data-sortable="true">Updated At</th>
                <th data-field="SIM_DELETED_AT" data-sortable="true">Deleted At</th>
                <th data-field="ACTION" data-sortable="false">Action</th>
            </tr>
        </thead>
        <tbody>
            <% data.forEach(item => { %>
            <tr>
                <td><%= item.SIM_ID %></td>
                <td><%= item.SIM_NUMBER %></td>
                <td><%= item.PROVIDER_NAME %></td>
                <td><%= item.TARIFF_NAME %></td>
                <td><%= item.LOC_NAME %></td>
                <td><%= item.ST_NAME %></td>
                <td><%= item.PIN1 %></td>
                <td><%= item.PUK1 %></td>
                <td><%= item.PIN2 %></td>
                <td><%= item.PUK2 %></td>
                <td><%= item.ACTIVATION_DATE %></td>
                <td><%= item.EXPIRATION_DATE %></td>
                <td><%= item.COMMENTS %></td>
                <td><%= item.SIM_CREATED_AT %></td>
                <td><%= item.SIM_UPDATED_AT %></td>
                <td><%= item.SIM_DELETED_AT %></td>
                <td>
                    <a class="remove" data-id="<%= item.SIM_ID %>" title="Remove">
                        <i class="bi bi-trash"></i>
                    </a>
                </td>
            </tr>
            <% }) %>
        </tbody>
        </table>
    </div>

    <!-- Modal -->
    <%- include('partials/modal') %>

    <script src="https://cdn.jsdelivr.net/npm/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.24.0/dist/bootstrap-table.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/tableexport.jquery.plugin@1.29.0/tableExport.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.24.0/dist/bootstrap-table-locale-all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-table@1.24.0/dist/extensions/export/bootstrap-table-export.min.js"></script>
    <script src="/public/js/index.js" defer></script>
    <script src="/public/js/sim.js" defer></script>
</body>
</html>