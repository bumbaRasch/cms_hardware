<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/head', { title: 'Types' }) %>
</head>
<body id="body-pd">
    <!-- Alert message -->
    <div id="alert-container"></div>
    <!-- Header -->
    <%- include('header') %>
    <!-- Siderbar -->
    <%- include('sidebar', { currentPath: currentPath }) %>
        <h4>Type</h4>
        <div class="table-responsive">
            <table 
                data-show-export="true"
                id="table"
                data-toggle="table"
                data-toolbar="#toolbar"
                data-search="true"
                data-show-toggle="true"
                data-show-fullscreen="true"
                data-show-columns="true"
                data-show-columns-toggle-all="true"
                data-pagination="true"
                data-click-to-select="true"
                data-show-footer="true"
                data-show-pagination-switch="true"
                data-page-list="[10, 25, 50, all]"
                data-sortable="true"
                data-id-field="HT_ID"
                data-locale="en-US"
                data-url="/api/types"
                data-side-pagination="server"
                class="table table-bordered table-striped table-hover">
            <thead class="table-primary">
                <tr>
                    <th data-field="HT_NAME" data-sortable="true">Name</th>
                    <th data-field="HT_CATEGORY" data-sortable="true">Category</th>
                    <th data-field="HT_DESCRIPTION" data-sortable="true">Description</th>
                    <!-- <th data-field="operate" data-formatter="operateFormatter" data-events="operateEvents">Actions</th> -->
                </tr>
            </thead>
            </table>
        </div>

    <!-- Modal -->
    <%- include('partials/modal') %>
    <!-- Footer -->
    <%- include('footer') %>
    <!-- Scripts -->
    <%- include('partials/scripts') %>
</body>
</html>