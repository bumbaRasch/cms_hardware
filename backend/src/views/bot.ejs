<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/head', { title: 'Bot' }) %>
</head>
<body id="body-pd">
    <!-- Alert message -->
    <div id="alert-container"></div>
    <!-- Header -->
    <%- include('header') %>
    <!-- Siderbar -->
    <%- include('sidebar', { currentPath: currentPath }) %>
    <!-- Form for question -->
    <div class="container">
        <h4>Bot</h4>
        <form id="ask-form" class="mb-4">
            <div class="mb-3">
                <label for="question" class="form-label">Ask a question:</label>
                <input type="text" class="form-control" id="question" required placeholder="Your question here">
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
        <!-- Table -->
        <table id="table"></table>
    </div>

    <!-- Footer -->
    <%- include('footer') %>
    <!-- Scripts -->
    <%- include('partials/scripts') %>
    <script src="/public/js/bot.js" defer type="module"></script>
</body>
</html>