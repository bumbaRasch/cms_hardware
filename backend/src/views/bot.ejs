<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('partials/head', { title: 'Bot' }) %>
</head>
<body id="body-pd">
    <!-- Alert message -->
    <div id="alert-container"></div>
    <!-- Header -->
    <%- include('header') %>
    <!-- Siderbar -->
    <%- include('sidebar', { currentPath: currentPath }) %>
    <h4>Bot</h4>
    <!-- Form for question -->
    <form id="ask-form" class="mb-4">
        <div class="mb-3">
            <label for="question" class="form-label">Ask a question:</label>
            <input type="text" class="form-control" id="question" required placeholder="Your question here">
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
    <!-- Table -->
    <div class="table-responsive">
        <table id="table" ></table>
    </div>

    <!-- Footer -->
    <%- include('footer') %>
    <!-- Scripts -->
    <%- include('partials/scripts') %>
    <script src="/public/js/bot.js" defer nonce="<%= locals.nonce %>"></script>
</body>
</html>