# Application environment: "development" or "production"
NODE_ENV=development  

# Database connection settings (MySQL example)
DB_USER=username
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cms_hardware
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Security: Number of salt rounds for password hashing (bcrypt)
# Recommended: 10+ for production, lower for faster testing
SALT_ROUNDS=10  

# Server settings
PORT=3000  # The port the server will listen on
HOST=127.0.0.1  # Use 0.0.0.0 to allow external access

# Logging level: debug (dev), info (prod), warn, error
LOG_LEVEL=debug  

# CORS settings: Allowed frontend origin (change for production)
CORS_ORIGIN=http://localhost:3000  
