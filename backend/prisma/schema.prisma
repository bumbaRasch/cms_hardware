  tbl_companies tbl_companies @relation(fields: [COMPANY_ID], references: [COMPANY_ID], onUpdate: Restrict, map: "tbl_user_companies_ibfk_2")

  @@id([USER_ID, COMPANY_ID])
  @@index([COMPANY_ID], map: "COMPANY_ID")
